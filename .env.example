# Conexión a Neon Postgres. En Vercel la carga sola la integración de Neon (Storage → Neon).
# Local: `vercel env pull .env.local`, o copiarla del panel de Neon a .env.local.
# Sin esta variable, los proyectos salen de lib/projects.seed.ts.
DATABASE_URL=postgresql://<usuario>:<password>@<host>.neon.tech/neondb?sslmode=require
